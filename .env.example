# --- Outbound (third party API) HTTP behaviour ---
# Applied to every axios call that does not set its own timeout.
HTTP_DEFAULT_TIMEOUT_MS=15000
# Extra attempts after the first one (0 disables retries).
HTTP_RETRY_ATTEMPTS=2
HTTP_RETRY_BASE_DELAY_MS=200
HTTP_RETRY_MAX_DELAY_MS=2000
# never | connection-errors-only | always - retry policy for POST/PUT/PATCH/DELETE.
HTTP_RETRY_UNSAFE_METHODS=connection-errors-only
HTTP_KEEP_ALIVE=true
HTTP_MAX_SOCKETS=64
HTTP_MAX_FREE_SOCKETS=16

# --- Observability ---
# Outbound calls slower than this are logged at warn level.
SLOW_UPSTREAM_WARN_MS=3000
# Inbound requests slower than this are logged at warn level.
SLOW_REQUEST_WARN_MS=5000
# One row per outbound call in integration_call_logs.
LOG_UPSTREAM_CALLS_TO_DB=true
# Upstream query strings may contain personal data (SSN, document numbers).
LOG_UPSTREAM_QUERY=false
# Persist inbound request body/query in request_logs.
LOG_REQUEST_BODIES=true

# --- HTTP server timeouts ---
SERVER_KEEP_ALIVE_TIMEOUT_MS=65000
SERVER_REQUEST_TIMEOUT_MS=60000
